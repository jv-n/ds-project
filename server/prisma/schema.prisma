datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}


generator dbml {
  provider = "prisma-dbml-generator"
}

model Usuario {
  id         Int        @id @default(autoincrement())
  cnpj       String     @unique
  email      String     @unique
  senha      String
  telefone   String?
  perfil     String @default("empresa") // empresa, prefeitura

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  empresa    Empresa?
}

model Empresa {
  id                Int       @id @default(autoincrement())
  nome              String
  pontuacao         Int       @default(0)
  numColaboradores  Int       @default(0)
  
  usuarioId    Int       @unique
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])

  odsId        Int[]
  acoes        AcaoEmpresa[]
  selos        Selo[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AcaoEmpresa {
  acaoId          Int        
  empresaId       Int   
  @@id(name: "acaoEmpresaId", [acaoId, empresaId]) 
  nome            String
  descricao       String
  nomeOng         String
  emailOng        String
  telefoneOng     String
  doacoes         Doacao[]
  odsAcao       Int[]

  empresa         Empresa    @relation(fields: [empresaId], references: [id])
}

model Doacao {
  id           Int        @id @default(autoincrement())
  data         DateTime
  valor        Float
  tipo         String
  documentos   Documento[]
  status       String @default("Pendente") // pendente, aprovado, reprovado
  motivoReprovacao String?
  empresaId    Int
  acaoId       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  acao         AcaoEmpresa       @relation(fields: [acaoId, empresaId], references: [acaoId, empresaId])
}

model Selo {
  id            Int        @id @default(autoincrement())
  nivel         String
  descricao     String
  pontuacaoMin  Int
  ano           Int
  createdAt     DateTime   @default(now())
  empresaId     Int     

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
}

model Documento {
  id         String   @id @default(uuid())
  storedName String
  mimetype   String
  size       Int
  path       String
  createdAt  DateTime @default(now())
  doacaoId    Int?

  doacao      Doacao?   @relation(fields: [doacaoId], references: [id])
}